{
  "name": "hofheim-launcher",
  "version": "1.0.12",
  "description": "Launcher oficial do servidor Hofheim - Valheim",
  "author": "Hofheim-valheim",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc -p tsconfig.electron.json && electron-builder",
    "preview": "vite preview"
  },
  "build": {
    "appId": "com.hofheim.launcher",
    "productName": "Hofheim Launcher",
    "win": {
      "target": "nsis",
      "icon": "src/assets/icon.png",
      "artifactName": "HofheimLauncher-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icons",
      "category": "Game",
      "maintainer": "Hofheim-valheim <hofheim-valheim@users.noreply.github.com>",
      "synopsis": "Launcher oficial do servidor Hofheim - Valheim",
      "artifactName": "HofheimLauncher-${version}-${arch}.${ext}"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "publish": {
      "provider": "github",
      "owner": "Hofheim-valheim",
      "repo": "Hofheim-Launcher"
    }
  },
  "dependencies": {
    "adm-zip": "^0.6.0",
    "axios": "^1.6.0",
    "electron-updater": "^6.1.7",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.5",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "concurrently": "^8.2.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "typescript": "^5.3.0",
    "vite": "^8.2.2",
    "vite-plugin-electron": "^0.28.0",
    "vite-plugin-electron-renderer": "^0.14.5",
    "wait-on": "^7.2.0"
  },
  "allowScripts": {
    "electron@28.3.3": true,
    "esbuild@0.21.5": true
  }
}
